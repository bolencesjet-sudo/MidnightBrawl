# This is a reference only: PHP reads process environment variables, not this file.
# Configure secrets on the PHP host. Never put secrets in browser variables.
TF_ENV=production
TF_APP_URL=https://your-domain.example
TF_APP_KEY=replace-with-at-least-32-random-characters
TF_DB_HOST=your-mysql-host
TF_DB_PORT=3306
TF_DB_NAME=tfv1
TF_DB_USER=tfv1_app
TF_DB_PASSWORD=replace-with-a-unique-database-password
TF_DB_SSL_CA=/absolute/private/path/to/database-ca.pem
# Set only behind a trusted proxy that overwrites X-Forwarded-Proto.
TF_TRUST_PROXY=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bolencesjet@gmail.com
SMTP_PASSWORD=replace-with-your-google-app-password
SMTP_FROM_EMAIL=bolencesjet@gmail.com
SMTP_FROM_NAME=Midnight Brawl
# CLI bootstrap only. Remove TF_ADMIN_PASSWORD after creation.
TF_ADMIN_USERNAME=bolencesjet
TF_ADMIN_EMAIL=bolencesjet@gmail.com
TF_ADMIN_NAME=Administrator
TF_ADMIN_PASSWORD=choose-a-unique-long-passphrase
